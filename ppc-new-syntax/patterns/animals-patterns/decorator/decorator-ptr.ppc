#include <stdio.h>

// Обобщенное животное
typedef struct Animal {} case{} Animal;
void GetInfo<Animal* a>() = 0;

// Утка
typedef struct Duck {} Duck;
Animal + {Duck duck;};

void GetInfo<Animal.duck* a>() {
  printf("I am the Duck");
};

// Собака
typedef struct Dog {} Dog;
Animal + {Dog dog;};

void GetInfo<Animal.dog* a>() {
  printf("I am the Dog");
};

//------------------------------------------------------------------------------
// Использование отдельных декораторов, непосредственно подключаемых к животным
//------------------------------------------------------------------------------

// Декоратор, добавляющий возраст
typedef struct AgeDecorator {int age;} case {} AgeDecorator;
AgeDecorator + {Animal* animal;};

void InitAgeDecorator(AgeDecorator.animal* da, Animal* a, int age) {
  da->age = age;
  da->animal = a;
}

Animal + {AgeDecorator ageDecorator;};
void GetInfo<Animal.ageDecorator* a>() {
  // Перенаправление дальше на животного
  AgeDecorator.animal *d = (AgeDecorator.animal*)&a->ageDecorator;
  GetInfo<d->animal>();
  printf(", I am %d yeas old.", a->ageDecorator.age);
}

// Декоратор, добавляющий имя
typedef struct NameDecorator {char* name;} case {} NameDecorator;
NameDecorator + {Animal* animal;};

void InitNameDecorator(NameDecorator.animal* da, Animal* a, char* name) {
  da->name = name;
  da->animal = a;
}

Animal + {NameDecorator nameDecorator;};

void GetInfo<Animal.nameDecorator* a>() {
  printf("My name is %s. ", a->nameDecorator.name);
  // Перенаправление дальше на животного
  NameDecorator.animal* d = &a->nameDecorator;
  GetInfo<d->animal>();
}

//------------------------------------------------------------------------------
// Клиент запускает сформированных животных
void ClientCode(Animal* a) {
  printf("\n");
  GetInfo<a>();
  printf("\n");
}

//------------------------------------------------------------------------------
int main() {
  printf("Different Animals:\n");
  Animal.duck duck;
  Animal.dog  dog;
  ClientCode(&duck);
  ClientCode(&dog);

  Animal.ageDecorator.animal duckAge;
  InitAgeDecorator(&(duckAge.ageDecorator), &duck, 2);
  ClientCode(&duckAge);

  Animal.nameDecorator.animal duckName;
  InitNameDecorator(&(duckName.nameDecorator), &duck, "Grey Neck");
  ClientCode(&duckName);

  Animal.nameDecorator.animal dogName;
  Animal.ageDecorator.animal  dogAge;
  InitNameDecorator(&(dogName.nameDecorator), &dog, "Rex");
  InitAgeDecorator(&(dogAge.ageDecorator), &dogName, 10);
  ClientCode(&dogAge);

  Animal.ageDecorator.animal  otherDogAge;
  Animal.nameDecorator.animal otherDogName;
  InitAgeDecorator(&(otherDogAge.ageDecorator), &dog, 10);
  InitNameDecorator(&(otherDogName.nameDecorator), &otherDogAge, "Mu-mu");
  ClientCode(&otherDogName);

  return 0;
}