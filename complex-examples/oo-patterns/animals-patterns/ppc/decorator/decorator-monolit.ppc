// Компилировать: ppclang -xc decorator-monolit.ppc -o decorator-monolit
#include <stdio.h>

// Обобщенное животное
typedef struct Animal {} case{} Animal;
void GetInfo<Animal* a>() = 0;

// Утка
typedef struct Duck {} Duck;
Animal + {Duck duck;};

void GetInfo<Animal.duck* a>() {
  printf("I am the Duck");
};

// Собака
typedef struct Dog {} Dog;
Animal + {Dog dog;};

void GetInfo<Animal.dog* a>() {
  printf("I am the Dog");
};

//------------------------------------------------------------------------------
// Использование отдельных декораторов, непосредственно подключаемых к животным
//------------------------------------------------------------------------------

// Декоратор, добавляющий возраст
typedef struct AgeDecorator {int age;} case{} AgeDecorator;
AgeDecorator + {Animal animal;};

void InitAgeDecorator(AgeDecorator* a, int age) {
  a->age = age;
}
Animal + {AgeDecorator ageDecorator;};

void GetInfo<Animal.ageDecorator* a>() {
  // Перенаправление дальше на животного
  AgeDecorator.animal* d = (struct AgeDecorator.animal*)&(a->ageDecorator);
  GetInfo<(Animal*)&(d->animal)>();
  printf(", I am %d yeas old.", a->ageDecorator.age);
}

// Декоратор, добавляющий имя
typedef struct NameDecorator {char* name;} case{} NameDecorator;
NameDecorator + {Animal animal;};

void InitNameDecorator(NameDecorator* a, char* name) {
  a->name = name;
}

Animal + {NameDecorator nameDecorator;};
void GetInfo<Animal.nameDecorator* a>() {
  printf("My name is %s. ", a->nameDecorator.name);
  // Перенаправление дальше на животного
  NameDecorator.animal* d = (NameDecorator.animal*)&(a->nameDecorator);
  GetInfo<(Animal*)&(d->animal)>();
}

//------------------------------------------------------------------------------
// Клиент запускает сформированных животных
void ClientCode(Animal* a) {
  printf("\n");
  GetInfo<a>();
  printf("\n");
}

//------------------------------------------------------------------------------
int main() {
  printf("Different Animals:\n");
  Animal.duck duck;
  Animal.dog  dog;

  ClientCode(&duck);
  ClientCode(&dog);

  Animal.ageDecorator.duck duckAge;
  InitAgeDecorator(&duckAge.ageDecorator, 2);
  ClientCode(&duckAge);

  Animal.nameDecorator.ageDecorator.dog dogNameAge;
  InitNameDecorator(&dogNameAge.nameDecorator, "Rex");
  InitAgeDecorator(&dogNameAge.nameDecorator.animal.ageDecorator, 10);
  ClientCode(&dogNameAge);

  Animal.ageDecorator.nameDecorator.dog otherDogAgeName;
  InitAgeDecorator(&otherDogAgeName.ageDecorator, 5);
  InitNameDecorator(&otherDogAgeName.ageDecorator.animal.nameDecorator, "Mu-mu");
  ClientCode(&otherDogAgeName);

  return 0;
}